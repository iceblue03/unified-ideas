# 선택 사항. 설정하지 않으면 기본 검색(TF-IDF 유사도)만 동작하고,
# AI 토글을 켜도 검색어 생성/순위 판단/진단 리포트 없이 대회 결과만 표시됩니다.
# OpenRouter API 키 (https://openrouter.ai) — nvidia/nemotron-3.5-lightning:free 모델 호출에 사용
# (속도·안정성 기준으로 선택함, 자세한 내용은 lib/openrouter.ts 참고)
openrouter_key=

# 선택 사항. 설정하지 않으면 "제품" 탭(eBay 상품 검색)이 비활성 상태로 표시됩니다.
# eBay 개발자센터(https://developer.ebay.com)에서 발급받은 키셋의 App ID / Cert ID
# (네이버쇼핑 검색 API는 서비스 종료되어 eBay Browse API로 대체함)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# 선택 사항. 프로덕션 키 대신 샌드박스 키만 있다면 sandbox로 설정 (기본값: production)
EBAY_ENV=
# 선택 사항. 검색 대상 마켓플레이스 (기본값: EBAY_US)
EBAY_MARKETPLACE_ID=

# 선택 사항. 설정하지 않으면 "특허" 탭(KIPRIS 특허 검색)이 비활성 상태로 표시됩니다.
# KIPRIS Plus(https://plus.kipris.or.kr) 가입 후 발급받은 서비스 키
KIPRIS_SERVICE_KEY=

# 선택 사항. 검색 로그를 구글 시트에 남기는 기능. 하나라도 비어있으면 로깅이
# 조용히 꺼집니다(검색 자체는 항상 정상 동작). Google Cloud 콘솔에서 서비스
# 계정을 만들고, Google Sheets API를 활성화한 뒤, 로그를 쌓을 시트를 만들어
# 그 시트를 서비스 계정 이메일에 편집자로 공유하세요.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 서비스 계정 키(JSON)의 private_key 값. Vercel 대시보드에는 줄바꿈 그대로
# 붙여넣고, 여기(.env.local)처럼 한 줄로 넣을 땐 "\n"으로 이스케이프하세요.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 로그를 쌓을 구글 시트의 ID (시트 URL의 /d/와 /edit 사이 문자열)
GOOGLE_SHEET_ID=

# 선택 사항. 설정하지 않으면 구글 로그인 버튼이 표시되지 않고, 모든 검색이
# 익명(anon_id 쿠키)으로만 로그에 남습니다. Google Cloud 콘솔의 OAuth 동의
# 화면 + "웹 애플리케이션" 유형 OAuth 클라이언트 ID를 만들고, 승인된 자바스크립트
# 원본에 배포 도메인과 http://localhost:3000을 등록하세요. Client Secret은
# 필요 없습니다(Google Identity Services의 ID 토큰 플로우는 Client ID만 사용).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 로그인 세션(JWT) 서명用 비밀값. 예: openssl rand -base64 32
SESSION_SECRET=
