# 선택 사항. 설정하지 않으면 기본 검색(TF-IDF 유사도)만 동작하고,
# AI 토글을 켜도 검색어 생성/순위 판단/진단 리포트 없이 대회 결과만 표시됩니다.
# OpenRouter API 키 (https://openrouter.ai) — nex-agi/nex-n2.5-mini:free 모델 호출에 사용
# (프롬프트를 학습에 쓰지 않는 데이터 정책의 모델만 선택함, 자세한 내용은 lib/openrouter.ts 참고)
openrouter_key=

# 선택 사항. 설정하지 않으면 "제품" 탭(네이버쇼핑 검색)이 비활성 상태로 표시됩니다.
# 네이버 개발자센터(https://developers.naver.com)에서 발급받은 검색 API 앱 키
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택 사항. 설정하지 않으면 "특허" 탭(KIPRIS 특허 검색)이 비활성 상태로 표시됩니다.
# KIPRIS Plus(https://plus.kipris.or.kr) 가입 후 발급받은 서비스 키
KIPRIS_SERVICE_KEY=
